import { Readable } from "node:stream"

const readableStream = new Readable()

readableStream._read = function () {
  this.push('艺术美学')
  this.push('艺术美学是美学与艺术学交叉的核心领域，主要研究艺术作为审美现象的本质、经验、价值与意义。')
  this.push('它既追问“艺术是什么”“艺术为何动人”，也分析艺术创作、作品、接受与社会文化之间的关系。')
  this.push('核心问题：')
  this.push('艺术本质：艺术与非艺术的边界在哪里？现成品、观念艺术、AI艺术算艺术吗？')
  this.push('审美经验：人面对艺术时产生的感受、想象、情感、判断如何发生？')
  this.push('形式与内容：线条、色彩、声音、结构如何承载意义？')
  this.push('价值与评价：什么是好艺术？审美判断有普遍性吗？')
  this.push('创作与接受：艺术家意图、作品文本、观众解读之间是什么关系？')
  this.push('西方脉络：')
  this.push('从柏拉图、亚里士多德开始，艺术美学就与模仿、净化、美的问题相关。')
  this.push('18世纪鲍姆嘉通命名“美学”，康德讨论审美无利害、共通感与天才，黑格尔提出“美是理念的感性显现”。')
  this.push('20世纪后，分析美学关注艺术定义，如丹托的“艺术界”、迪基的“体制论”；现象学重视审美对象与经验；法兰克福学派批判文化工业；结构主义、后结构主义则关注符号、权力与意义滑动。')
  this.push('中国脉络：')
  this.push('中国虽无完全对应的“美学”学科名，但有丰富艺术审美思想：孔子的“尽善尽美”、老庄的自然与虚静、刘勰《文心雕龙》、司空图《二十四诗品》、严羽“妙悟”、王夫之“情景交融”、王国维“境界说”，以及宗白华的“意境”、朱光潜的审美心理、李泽厚的实践美学等。')
  this.push('气韵、意境、虚实、留白、中和等，都是重要范畴。')
  this.push('当代议题：')
  this.push('今天艺术美学面对艺术边界消解、大众文化、数字媒介、人工智能生成艺术、跨文化审美差异等问题，越来越不追求唯一本质，而关注具体情境中的意义生成、体制运作与审美经验。')
  this.push('一句话：艺术美学研究艺术如何成为审美对象，以及它如何产生经验、价值与意义。')
